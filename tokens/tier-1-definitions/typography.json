{
  "font": {
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
      "$type": "fontFamily"
    },
    "mono": {
      "$value": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, monospace",
      "$type": "fontFamily"
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.5rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium":  { "$value": "500" },
      "bold":    { "$value": "600" }
    }
  },
  "line": {
    "height": {
      "$type": "number",
      "tight":  { "$value": "1.2" },
      "normal": { "$value": "1.5" }
    }
  },
  "letter": {
    "spacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.01em" },
      "normal": { "$value": "0" },
      "wide":   { "$value": "0.02em" }
    }
  }
}
